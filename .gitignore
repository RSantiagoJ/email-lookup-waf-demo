# dependencies
node_modules/

# build / synth output
dist/
cdk.out/
*.tsbuildinfo

# compiled CDK TypeScript (regenerated by `npx tsc` after clone)
infra/bin/*.js
infra/bin/*.d.ts
infra/lib/*.js
infra/lib/*.d.ts

# local secrets — NOTE: app/.env is committed on purpose (it holds only the public
# API URL, which the dashboard needs to work after a clone). Never put the Anthropic
# key in a file — it is injected from the deploy shell env, not from the repo.
.env.local
*.local
*.key
*.pem

# os cruft
.DS_Store
Thumbs.db
