# Copy to arns.env and fill from the `cdk deploy` outputs, then `source arns.env`
# (the waf-on/waf-off scripts read these).
export WEBACL_ARN="arn:aws:wafv2:us-east-1:438920434591:regional/webacl/email-lookup-waf-demo/XXXXXXXX"
export STAGE_ARN="arn:aws:apigateway:us-east-1::/restapis/XXXXXXXX/stages/prod"
export AWS_REGION="us-east-1"
# On local Windows git-bash, point AWS at the full CLI path if `aws` isn't on PATH:
# export AWS="/c/Program Files/Amazon/AWSCLIV2/aws.exe"
